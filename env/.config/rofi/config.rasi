* {
  bg:    #0d1117;
  fg:    #cdd9e5;
  blue:  #58a6ff;
  dim:   #161b22;
  background-color: transparent;
  text-color:       @fg;
  font:             "JetBrains Mono Semi-Bold 35";
}
window {
  background-color: @bg;
  border:           1px;
  border-color:     @blue;
  border-radius:    0px;
  width:            1700px;
  padding:          16px;
}
mainbox {
  background-color: transparent;
  children:         [ inputbar, listview ];
  spacing:          12px;
}
inputbar {
  background-color: @dim;
  border-radius:    0px;
  padding:          12px 16px;
  children:         [ prompt, entry ];
}
prompt {
  text-color:       @blue;
  padding:          0 8px 0 0;
}
entry {
  text-color:       @fg;
  placeholder:      "search...";
  placeholder-color: #3d444d;
}
listview {
  background-color: transparent;
  lines:            10;
  scrollbar:        false;
  spacing:          4px;
}
element {
  background-color: transparent;
  border-radius:    0px;
  padding:          10px 16px;
}
element selected {
  background-color: @dim;
  text-color:       @blue;
}
element-icon {
  size:    24px;
  padding: 0 10px 0 0;
}
element-text {
  font: "JetBrains Mono Semi-Bold 25";
}

